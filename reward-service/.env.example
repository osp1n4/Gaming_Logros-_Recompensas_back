# Reward Service Environment Variables

# Server
PORT=3003
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rewards_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=reward.achievement_unlocked
RABBITMQ_EXCHANGE=reward.events
RABBITMQ_EXCHANGE_TYPE=topic
