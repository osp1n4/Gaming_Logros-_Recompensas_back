# Achievement Service Environment Variables

# Server
PORT=3002
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=achievements_db

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=achievement.player_actions
RABBITMQ_EXCHANGE=achievement.events
RABBITMQ_EXCHANGE_TYPE=topic
